{
  "name": "google-secops",
  "contextFileName": "GEMINI.md",
  "description": "Essential Security Operations skills for Triage, Investigation, and Hunting.",
  "version": "1.2.3",
  "skills": [
    "skills/secops-triage",
    "skills/secops-investigate",
    "skills/secops-hunt",
    "skills/secops-cases",
    "skills/secops-detection-engineering",
    "skills/detection-engineering-coverage-evaluation"
  ],
  "settings": [
    {
      "name": "PROJECT_ID",
      "description": "Your Google Cloud Project ID (from /settings/profile).",
      "envVar": "PROJECT_ID",
      "sensitive": false
    },
    {
      "name": "CUSTOMER_ID",
      "description": "Your Google SecOps Customer UUID (from /settings/profile).",
      "envVar": "CUSTOMER_ID",
      "sensitive": false
    },
    {
      "name": "REGION",
      "description": "Your Google SecOps Region (e.g. 'us', 'europe-west1').",
      "envVar": "REGION",
      "sensitive": false
    },
    {
      "name": "SERVER_URL",
      "defaultValue": "https://chronicle.us.rep.googleapis.com/mcp",
      "description": "The URL of the remote MCP server. See https://docs.cloud.google.com/chronicle/docs/secops/use-google-secops-mcp.",
      "envVar": "SERVER_URL",
      "sensitive": false
    }
  ],
  "mcpServers": {
    "secops": {
      "httpUrl": "https://chronicle.us.rep.googleapis.com/mcp",
      "authProviderType": "google_credentials",
      "oauth": {
        "scopes": [
          "https://www.googleapis.com/auth/cloud-platform"
        ]
      },
      "headers": {
        "User-Agent": "agent-skills/1.0 (skill:google-secops)",
        "x-goog-user-project": "${PROJECT_ID}"
      },
      "env": {
        "PROJECT_ID": "${PROJECT_ID}",
        "CUSTOMER_ID": "${CUSTOMER_ID}",
        "REGION": "${REGION}"
      },
      "disabledTools": [
        "list_log_types",
        "list_parsers",
        "list_integrations",
        "list_integration_actions",
        "execute_manual_action",
        "create_reference_list",
        "get_reference_list"
      ]
    }
  }
}
